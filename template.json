  "audit": {
    "liveWriteExempt": [
      {
        "table": "rate_bucket",
        "reason": "Rate-limit counters, written on public calls many times a minute; no screen shows them."
      },
      {
        "table": "otp_code",
        "reason": "One-time codes, stored hashed and read only by the server to check what a signer types; no screen shows them."
      },
      {
        "table": "signing_link",
        "reason": "Signing-link fingerprints, read only by the server; the trail records each link made, and the document's page reloads on the change that follows."
      },
      {
        "table": "audit_event",
        "reason": "The audit trail is written by every step on a document, alongside the change that step announces; announcing each event too would double every frame."
      },
      {
        "table": "webhook_delivery",
        "reason": "Delivery attempts, written by every event and every retry; the Developers page reads them when it opens and after its own actions."
      },
      {
        "table": "api_key_use",
        "reason": "An append-only log of API calls, one per call, so reads never write; the key list reads the latest when it opens."
      },
      {
        "table": "document_blob",
        "reason": "A stored file's bytes, written by uploads and the seal; the envelope change that follows announces it."
      },
      {
        "table": "document_file",
        "reason": "A stored file's row, written by uploads and the seal; the envelope change that follows announces it."
      },
      {
        "table": "org_setting",
        "reason": "Apart from Settings (which announces its saves), only the app's own address is written here, learned quietly from requests; no screen shows it."
      },
      {
        "table": "field",
        "reason": "A signer filling their fields, keystroke by keystroke through their session; the sender's page is told after each save by an ids-only change on the envelope."
      },
      {
        "table": "signature",
        "reason": "A signer's adopted mark; the envelope change that follows it announces it, and only the signer's own page shows it before they finish."
      }
    ]
  },
  "qa": {
